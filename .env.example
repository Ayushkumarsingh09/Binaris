BINARIS_API_HOST=0.0.0.0
BINARIS_API_PORT=8080
BINARIS_JWT_SECRET=change-me-in-production-use-long-secret
BINARIS_INLINE_ANALYZE=true
BINARIS_STORAGE_BACKEND=local
BINARIS_STORAGE_PATH=./data/objects
# DATABASE_URL=postgres://binaris:binaris@127.0.0.1:5432/binaris
# REDIS_URL=redis://127.0.0.1:6379
BINARIS_AI_PROVIDER=local
# BINARIS_AI_PROVIDER=openai
# BINARIS_AI_MODEL=gpt-4o
# BINARIS_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
NEXT_PUBLIC_BINARIS_API_URL=http://127.0.0.1:8080
RUST_LOG=info

# OAuth / OIDC (optional)
# BINARIS_OAUTH_GOOGLE_CLIENT_ID=
