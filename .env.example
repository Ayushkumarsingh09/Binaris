# BINARIS_OAUTH_GITHUB_CLIENT_SECRET=
# BINARIS_OIDC_AUTH_URL=
# BINARIS_OIDC_TOKEN_URL=
# BINARIS_OIDC_USERINFO_URL=
# BINARIS_OAUTH_OIDC_CLIENT_ID=
# BINARIS_OAUTH_OIDC_CLIENT_SECRET=

# Decomp backends (optional external tools on PATH / GHIDRA_HOME)
